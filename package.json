{
  "name": "kopra-website",
  "version": "1.0.0",
  "private": true,
  "description": "Premium website for KOPRA — India's first non-alcoholic cocktail bar, Nanthancodu, Thiruvananthapuram.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:reset": "rm -f data/kopra.db && node --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wrangler": "4.148.0"
  }
